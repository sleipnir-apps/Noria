PORT=3000
HOST=0.0.0.0
NODE_ENV=development
MONGO_URL=mongodb://admin:password@localhost:27017/myapp?authSource=admin
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
CORS_CREDENTIALS=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# JWT — access token (court, 5 min)
JWT_SECRET=changeme_changeme_changeme_changeme_32chars
JWT_ACCESS_EXPIRES=5m

# JWT — refresh token (long, 90 jours / 3 mois). Secret DIFFÉRENT de l'access.
JWT_REFRESH_SECRET=changeme_refresh_refresh_refresh_32chars
JWT_REFRESH_EXPIRES=90d

LOG_LEVEL=info