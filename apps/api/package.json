{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "bun test --preload ./src/test/setup.ts",
    "build": "bun build src/server.ts --outdir dist --target bun",
    "db:migrate": "bun src/migrations/migration-runner.ts",
    "db:migrate:status": "bun src/migrations/migration-status.ts",
    "db:migrate:create": "bun src/migrations/create-migration.ts",
    "db:seed": "bun src/seeds/development.ts",
    "db:seed:test": "NODE_ENV=test bun src/seeds/test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.1",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.0",
    "@template/contracts": "workspace:*",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.10.0",
    "mongodb": "^6.21.0",
    "rrule": "2.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.1.1",
    "mongodb-memory-server": "10.4.3",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.9.3"
  }
}
