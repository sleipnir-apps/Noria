{
  "name": "noria",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "bun run --cwd apps/api dev",
    "dev:front": "bun --cwd apps/mobile start",
    "dev:front:web": "bun --cwd apps/mobile web",
    "dev:front:android": "bun --cwd apps/mobile android",
    "dev:front:ios": "bun --cwd apps/mobile ios",
    "lint": "bun run --workspaces lint",
    "lint:mobile": "bun run --cwd apps/mobile lint",
    "lint:api": "bun run --cwd apps/api lint",
    "typecheck": "bun run --workspaces typecheck",
    "typecheck:mobile": "bun run --cwd apps/mobile typecheck",
    "typecheck:api": "bun run --cwd apps/api typecheck",
    "test": "bun run --workspaces --if-present test",
    "test:api": "bun run --cwd apps/api test",
    "build": "bun run --workspaces build",
    "build:mobile": "bun run --cwd apps/mobile build",
    "build:api": "bun run --cwd apps/api build",
    "db:up": "docker compose up -d mongodb",
    "db:down": "docker compose down",
    "db:migrate": "bun run --cwd apps/api db:migrate",
    "db:migrate:status": "bun run --cwd apps/api db:migrate:status",
    "db:migrate:create": "bun run --cwd apps/api db:migrate:create",
    "db:seed": "bun run --cwd apps/api db:seed",
    "db:seed:test": "bun run --cwd apps/api db:seed:test"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6"
  },
  "dependencies": {
    "expo": "^57.0.25",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "version": "1.0.0"
}
